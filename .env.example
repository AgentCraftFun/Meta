# Provider selection. Defaults to 'mock' if unset or if X_BEARER_TOKEN
# is missing.
NARRATIVE_SOURCE=mock

# X (Twitter) v2 paid tier bearer token. Required when NARRATIVE_SOURCE=x.
X_BEARER_TOKEN=

# Token data source. 'mock' | 'dexscreener' | 'birdeye'. Defaults to 'mock'.
# DexScreener and Birdeye live integrations are stubs — they return empty
# arrays until implemented. Use 'mock' for development / preview.
TOKEN_SOURCE=mock

# Upstash Redis HTTP. Both must be set to use shared cache; otherwise the
# in-process Map fallback is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron secret. When set, /api/cron/refresh requires
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
